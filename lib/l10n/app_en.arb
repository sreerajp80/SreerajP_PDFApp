  "helpSignaturesStep1": "When opening a signed PDF, tap the Signature Badge in the top bar to inspect signer details and byte coverage.",
  "@helpSignaturesStep1": { "description": "Step 1 for Digital Signatures" },
  "helpSignaturesStep2": "The app checks if the document has been altered or tampered with since it was signed.",
  "@helpSignaturesStep2": { "description": "Step 2 for Digital Signatures" },
