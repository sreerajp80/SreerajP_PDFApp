  "helpPageOpsStep1": "Open a document and tap the Page Operations menu (or use the Organizer view).",
  "@helpPageOpsStep1": { "description": "Step 1 for Page Operations" },
  "helpPageOpsStep2": "Select desired actions: Reorder pages by dragging, Rotate individual or all pages, or Delete unwanted pages.",
  "@helpPageOpsStep2": { "description": "Step 2 for Page Operations" },
  "helpPageOpsStep3": "Use 'Booklet Creation' for foldable 2-up booklets or 'N-Up Layout' to fit multiple pages (2, 4, 6, 9) onto a single sheet.",
  "@helpPageOpsStep3": { "description": "Step 3 for Page Operations" },
  "helpPageOpsStep4": "Tap Save / Export to generate a brand new PDF file in your chosen location.",
  "@helpPageOpsStep4": { "description": "Step 4 for Page Operations" },
  "helpPageOpsTip": "Safety Guarantee: Because operations create a new file, you can experiment freely without risking loss or damage to your original PDFs.",
