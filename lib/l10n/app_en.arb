  "helpPdfPrinterTopicHeader": "1. How to Enable the PDF Printer on Android",
  "@helpPdfPrinterTopicHeader": { "description": "Header for PDF Printer enable guide" },
  "helpPdfPrinterIntro": "On Android, virtual print services are managed at the system level. To enable Folio as a system-wide printer:",
  "@helpPdfPrinterIntro": { "description": "Intro explanation for enabling PDF printer" },
  "helpPdfPrinterStep1": "Open your Android device's Settings.",
  "@helpPdfPrinterStep1": { "description": "Step 1 to enable PDF printer" },
  "helpPdfPrinterStep2": "Go to Connected devices → Connection preferences → Printing (or search for \"Printing\" in your Settings search bar).",
  "@helpPdfPrinterStep2": { "description": "Step 2 to enable PDF printer" },
  "helpPdfPrinterStep3": "Under Print services, find Folio (or your app's name).",
  "@helpPdfPrinterStep3": { "description": "Step 3 to enable PDF printer" },
  "helpPdfPrinterStep4": "Tap it and switch the toggle to On.",
  "@helpPdfPrinterStep4": { "description": "Step 4 to enable PDF printer" },
  "helpOpenPrintSettings": "Open Print Settings",
  "@helpOpenPrintSettings": { "description": "Button to jump directly to Android print settings" },
  "helpUnicodePrintingTitle": "Unicode & Malayalam PDF Printing",
  "@helpUnicodePrintingTitle": { "description": "Title of Unicode PDF Printing topic in Help" },
  "helpUnicodePrintingSubtitle": "Printing complex Indic scripts without broken characters",
  "@helpUnicodePrintingSubtitle": { "description": "Subtitle of Unicode PDF Printing card in Help" },
  "helpUnicodePrintingTopicHeader": "Printing Unicode & Malayalam Text Accurately",
  "@helpUnicodePrintingTopicHeader": { "description": "Header for Unicode PDF Printing guide" },
  "helpUnicodePrintingIntro": "Standard Android printing can sometimes garble complex scripts (such as Malayalam, Hindi, or Sanskrit), resulting in broken chillu characters, disconnected conjuncts, or missing fonts. Folio handles complex script shaping and font embedding to generate pristine PDFs.",
  "@helpUnicodePrintingIntro": { "description": "Intro explanation for Unicode PDF printing" },
  "helpUnicodePrintingStep1": "Enable the PDF Virtual Printer in Android Settings if you haven't already.",
  "@helpUnicodePrintingStep1": { "description": "Step 1 for Unicode PDF printing" },
  "helpUnicodePrintingStep2": "In any app (such as Chrome, WhatsApp, or Office), select Print from the menu.",
  "@helpUnicodePrintingStep2": { "description": "Step 2 for Unicode PDF printing" },
  "helpUnicodePrintingStep3": "Select 'Folio' as the target printer instead of the standard Android 'Save as PDF'.",
  "@helpUnicodePrintingStep3": { "description": "Step 3 for Unicode PDF printing" },
  "helpUnicodePrintingStep4": "The app captures the print spool, resolves Unicode glyphs and fonts, and creates a crisp, readable PDF file.",
  "@helpUnicodePrintingStep4": { "description": "Step 4 for Unicode PDF printing" },
  "helpUnicodePrintingTip": "Tip: For web articles with complex layouts, enable 'Clean Web Content' in Printer Settings to strip unwanted ads and headers automatically.",
  "@helpUnicodePrintingTip": { "description": "Helpful tip for Unicode PDF printing" },
  "helpOpenPrinterSettings": "Open Printer Settings",
  "@helpOpenPrinterSettings": { "description": "Button to jump to Printer Settings" },
  "helpTtsTitle": "Read Aloud (TTS) & Malayalam Voice",
  "@helpTtsTitle": { "description": "Title of TTS topic in Help" },
  "helpTtsSubtitle": "Configure speech engine, voice speed, and Malayalam support",
  "@helpTtsSubtitle": { "description": "Subtitle of TTS card in Help" },
  "helpTtsTopicHeader": "How to Use Read Aloud and Install Malayalam Voices",
  "@helpTtsTopicHeader": { "description": "Header for TTS guide" },
  "helpTtsIntro": "The app can read PDF text aloud using your device's Text-to-Speech (TTS) engine. It supports both English and Malayalam.",
  "@helpTtsIntro": { "description": "Intro explanation for TTS" },
  "helpTtsStep1": "Open any text-based PDF and tap the 'Read Aloud' (speaker) button in the top bar.",
  "@helpTtsStep1": { "description": "Step 1 for TTS" },
  "helpTtsStep2": "If the Malayalam voice is not installed, go to Settings → Read Aloud (TTS) and tap 'Get the Malayalam voice'.",
  "@helpTtsStep2": { "description": "Step 2 for TTS" },
  "helpTtsStep3": "You can customize speech speed, voice pitch, sentence-ending pauses, and auto-scrolling to match your reading style.",
  "@helpTtsStep3": { "description": "Step 3 for TTS" },
  "helpTtsTip": "Note: Scanned documents containing only images without a selectable text layer cannot be read aloud. OCR is not supported.",
  "@helpTtsTip": { "description": "Tip for TTS regarding scanned documents" },
  "helpOpenTtsSettings": "Open TTS Settings",
  "@helpOpenTtsSettings": { "description": "Button to jump to TTS Settings" },
  "helpPageOpsTitle": "Organizing & Modifying Pages",
  "@helpPageOpsTitle": { "description": "Title of Organizing Pages topic in Help" },
  "helpPageOpsSubtitle": "Merge, split, reorder, rotate, booklet, and N-Up layouts",
  "@helpPageOpsSubtitle": { "description": "Subtitle of Organizing Pages card in Help" },
  "helpPageOpsTopicHeader": "Page Operations & Copy-on-Write Safety",
  "@helpPageOpsTopicHeader": { "description": "Header for Page Operations guide" },
  "helpPageOpsIntro": "Easily reorganize or transform pages in your PDF documents. Every operation strictly adheres to Copy-on-Write — your original document is never modified in place.",
  "@helpPageOpsIntro": { "description": "Intro explanation for Page Operations" },
  "helpPageOpsStep1": "Open a document and tap the Page Operations menu (or use the Organizer view).",
  "@helpPageOpsStep1": { "description": "Step 1 for Page Operations" },
  "helpPageOpsStep2": "Select desired actions: Reorder pages by dragging, Rotate individual or all pages, or Delete unwanted pages.",
  "@helpPageOpsStep2": { "description": "Step 2 for Page Operations" },
  "helpPageOpsStep3": "Use 'Booklet Creation' for foldable 2-up booklets or 'N-Up Layout' to fit multiple pages (2, 4, 6, 9) onto a single sheet.",
  "@helpPageOpsStep3": { "description": "Step 3 for Page Operations" },
  "helpPageOpsStep4": "Tap Save / Export to generate a brand new PDF file in your chosen location.",
  "@helpPageOpsStep4": { "description": "Step 4 for Page Operations" },
  "helpPageOpsTip": "Safety Guarantee: Because operations create a new file, you can experiment freely without risking loss or damage to your original PDFs.",
  "@helpPageOpsTip": { "description": "Tip for Page Operations" },
  "helpSignaturesTitle": "Digital Signatures & Trust Store",
  "@helpSignaturesTitle": { "description": "Title of Digital Signatures topic in Help" },
  "helpSignaturesSubtitle": "Offline cryptographic verification and certificate management",
  "@helpSignaturesSubtitle": { "description": "Subtitle of Digital Signatures card in Help" },
  "helpSignaturesTopicHeader": "Verifying Digital Signatures Offline",
  "@helpSignaturesTopicHeader": { "description": "Header for Digital Signatures guide" },
  "helpSignaturesIntro": "Folio verifies digital signatures completely offline using cryptographic algorithms (SHA-256 digests and X.509 certificate chains) with zero network requests.",
  "@helpSignaturesIntro": { "description": "Intro explanation for Digital Signatures" },
  "helpSignaturesStep1": "When opening a signed PDF, tap the Signature Badge in the top bar to inspect signer details and byte coverage.",
  "@helpSignaturesStep1": { "description": "Step 1 for Digital Signatures" },
  "helpSignaturesStep2": "The app checks if the document has been altered or tampered with since it was signed.",
  "@helpSignaturesStep2": { "description": "Step 2 for Digital Signatures" },
  "helpSignaturesStep3": "If a certificate shows as untrusted, you can inspect the certificate chain and add trusted root certificates in the Trust Store.",
  "@helpSignaturesStep3": { "description": "Step 3 for Digital Signatures" },
  "helpSignaturesTip": "Security Note: All cryptographic checking runs locally in Kotlin using Bouncy Castle and CertPathValidator without sending documents to any remote server.",
  "@helpSignaturesTip": { "description": "Tip for Digital Signatures" },
  "helpOpenTrustStore": "Open Trust Store",
  "@helpOpenTrustStore": { "description": "Button to jump to Trust Store" },
  "helpPrivacyStorageTitle": "Privacy & Scoped Storage",
  "@helpPrivacyStorageTitle": { "description": "Title of Privacy & Storage topic in Help" },
  "helpPrivacyStorageSubtitle": "No internet servers, and Scoped Storage security",
  "@helpPrivacyStorageSubtitle": { "description": "Subtitle of Privacy & Storage card in Help" },
  "helpPrivacyStorageTopicHeader": "No-Internet Privacy Guarantee",
  "@helpPrivacyStorageTopicHeader": { "description": "Header for Privacy & Storage guide" },
  "helpPrivacyStorageIntro": "Your privacy is paramount. Folio never connects to the internet. Its only network use is Device sync, directly between your own phones on local WiFi.",
  "@helpPrivacyStorageIntro": { "description": "Intro explanation for Privacy & Storage" },
  "helpPrivacyStorageStep1": "No internet: Folio never contacts an internet server and collects no analytics. The INTERNET permission is used only by Device sync on your local WiFi, and only while that screen is open.",
  "@helpPrivacyStorageStep1": { "description": "Step 1 for Privacy & Storage" },
  "helpPrivacyStorageStep2": "Scoped Storage (SAF): The app only accesses files you explicitly pick via Android's system file picker.",
  "@helpPrivacyStorageStep2": { "description": "Step 2 for Privacy & Storage" },
  "helpPrivacyStorageStep3": "Temporary Cache Management: Render caches and printer spool files can be cleared at any time from Storage Settings.",
  "@helpPrivacyStorageStep3": { "description": "Step 3 for Privacy & Storage" },
  "helpPrivacyStorageTip": "Password Safety: Passwords entered for encrypted PDFs are kept in volatile memory only and are never saved to disk or logged.",
  "@helpPrivacyStorageTip": { "description": "Tip for Privacy & Storage" },
  "helpOpenStorageSettings": "Open Storage & Privacy Settings",
  "@helpOpenStorageSettings": { "description": "Button to jump to Storage Settings" },
