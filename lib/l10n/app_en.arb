  "helpUnicodePrintingStep3": "Select 'SreerajP PDF App' as the target printer instead of the standard Android 'Save as PDF'.",
  "@helpUnicodePrintingStep3": { "description": "Step 3 for Unicode PDF printing" },
  "helpUnicodePrintingStep4": "The app captures the print spool, resolves Unicode glyphs and fonts, and creates a crisp, readable PDF file.",
  "@helpUnicodePrintingStep4": { "description": "Step 4 for Unicode PDF printing" },
  "helpUnicodePrintingTip": "Tip: For web articles with complex layouts, enable 'Clean Web Content' in Printer Settings to strip unwanted ads and headers automatically.",
