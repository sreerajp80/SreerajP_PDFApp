<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): keep every app file out of cloud backup and out of
     device-to-device transfer. The app holds private data (recent files,
     annotations, trusted certificates, cached copies of opened PDFs) that must
     stay on this device (docs/security.md §10, engineering standard §15.2). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
