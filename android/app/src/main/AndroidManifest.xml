<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Device sync (plan 20261112_104132_device_sync_qr_wifi.md, Hard Rule 2).
         Android needs INTERNET for ANY socket, even phone-to-phone on the same
         WiFi. The app never contacts an internet host: sockets exist only in
         lib/features/nearby_transfer/data/ (CI check), bind to the private
         WiFi address, accept private LAN addresses only, and live only while
         the Device sync screen is open. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Scanning a Device sync QR code. Asked only when the scan screen opens. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Phones without a camera can still install the app and share settings. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required"/>
    <!-- The camera plugin also asks for these. Folio never records audio and
         never uses broad storage (Hard Rule 3), so they are removed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- The manifest merger adds READ_EXTERNAL_STORAGE by itself ("implied")
         whenever a library asks for WRITE_EXTERNAL_STORAGE, even though WRITE
         is removed above. Remove it too, or the release build asks for broad
         storage access. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Turn off Flutter's automatic deep-linking. The VIEW intent
                 filters below include the BROWSABLE category (needed for
                 "Open with"), which would otherwise make Flutter treat the
                 opened file's content:// URI as an initial route and hand it to
                 go_router, which has no matching route ("Page Not Found").
                 The app already handles the launch intent through its own native
                 bridge (getInitialIntent), so URL-style deep-link routing is not
                 used and is safely disabled here. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 1. Primary "Open with" / VIEW intent filter for PDF MIME types -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/x-pdf"/>
                <data android:mimeType="application/vnd.pdf"/>
            </intent-filter>

            <!-- 2. Fallback "Open with" / VIEW intent filter for generic/wildcard MIME types (e.g. */* or application/octet-stream) but ending with .pdf or .PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.pdf"/>
                <data android:pathPattern=".*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.PDF"/>
            </intent-filter>

            <!-- 3. Fallback "Open with" / VIEW intent filter for files with no MIME type specified but ending with .pdf or .PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.pdf"/>
                <data android:pathPattern=".*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\.PDF"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.PDF"/>
            </intent-filter>
            <!-- Share a PDF into the app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <!-- Print to PDF (Phase 6): another app shares a picture or some text and we
                 save it as a new PDF. This is what makes the app a "save as PDF" target. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>
        <!-- flutter_zxing pulls in image_picker (its gallery button, which Folio
             hides). Its Google Play services module hint is not wanted: Folio
             uses no Google services. -->
        <service android:name="com.google.android.gms.metadata.ModuleDependencies"
            tools:node="remove"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- System Virtual Print Service: allows other apps to print to Folio -->
        <service
            android:name=".PdfPrintService"
            android:permission="android.permission.BIND_PRINT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.printservice.PrintService" />
            </intent-filter>
            <meta-data
                android:name="android.printservice"
                android:resource="@xml/printservice" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Read aloud (Phase 2). Since Android 11 an app cannot see other apps
             unless it declares what it is looking for. Without this the speech
             engine is invisible: no voices are listed and read-aloud looks
             broken for no reason. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- So the "install the voice" and "get the speech engine" doors can be
             opened. Without these, startActivity finds nothing and the guided
             install would dead-end. -->
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
